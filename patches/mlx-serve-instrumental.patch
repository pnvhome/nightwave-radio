index 0000000..f63c97a
--- /dev/null
+++ b/src/yue2_instrumental.zig
@@ -0,0 +1,91 @@
+//! Official YuE2 Music Skill's event-level transfer, pinned and unmodified.
+//! Only this opt-in CPU step needs local Python 3.9+ (stdlib); inference stays MLX.
+const std = @import("std");
+const modules = .{
+    .abc_tools = @embedFile("yue2_instrumental/abc_tools.py"),
+    .common = @embedFile("yue2_instrumental/common.py"),
+    .compile_score = @embedFile("yue2_instrumental/compile_score.py"),
+    .instrumentalize = @embedFile("yue2_instrumental/instrumentalize.py"),
+};
+pub const Result = struct { abc: []u8, transfer: []u8, lyrics: []u8 };
+
+pub fn convert(a: std.mem.Allocator, io: std.Io, score: []const u8) !Result {
+    // Bounds both process arguments and CPU work; never silently fall back to singing.
+    if (score.len == 0 or score.len > 96 * 1024) return error.InstrumentalScoreTooLarge;
+    const sources = try std.json.Stringify.valueAlloc(a, modules, .{});
+    defer a.free(sources);
+    const python = if (std.c.getenv("YUE2_INSTRUMENTAL_PYTHON")) |p| std.mem.span(p) else "/usr/bin/python3";
+    const result = std.process.run(a, io, .{
+        .argv = &.{ python, "-I", "-c", @embedFile("yue2_instrumental/bridge.py"), sources, score },
+        .stdout_limit = .limited(1024 * 1024),
+        .stderr_limit = .limited(16 * 1024),
+    }) catch |err| switch (err) {
+        error.OutOfMemory => return error.OutOfMemory,
+        else => return error.InstrumentalPythonUnavailable,
+    };
+    defer a.free(result.stdout);
+    defer a.free(result.stderr);
+    switch (result.term) {
+        .exited => |code| if (code != 0) return error.InstrumentalScoreInvalid,
+        else => return error.InstrumentalScoreInvalid,
+    }
+    const parsed = try std.json.parseFromSlice(struct { abc: []const u8, transfer: std.json.Value, lyrics: []const u8 }, a, result.stdout, .{});
+    defer parsed.deinit();
+    const abc = try a.dupe(u8, parsed.value.abc);
+    errdefer a.free(abc);
+    const lyrics = try a.dupe(u8, parsed.value.lyrics);
+    errdefer a.free(lyrics);
+    return .{ .abc = abc, .lyrics = lyrics, .transfer = try std.json.Stringify.valueAlloc(a, parsed.value.transfer, .{}) };
+}
+
+fn containsIgnoreCase(text: []const u8, needle: []const u8) bool {
+    if (text.len < needle.len) return false;
+    for (0..text.len - needle.len + 1) |i| {
+        if (std.ascii.eqlIgnoreCase(text[i..][0..needle.len], needle)) return true;
+    }
+    return false;
+}
+
+/// The official prepare step adds these style guards in addition to moving notes.
+pub fn renderStyle(a: std.mem.Allocator, style: []const u8) ![]u8 {
+    var result: std.ArrayList(u8) = .empty;
+    errdefer result.deinit(a);
+    if (!containsIgnoreCase(style, "instrumental")) try result.appendSlice(a, "Instrumental, ");
+    try result.appendSlice(a, std.mem.trimEnd(u8, style, " .,"));
+    for ([_][]const u8{ "no vocals", "no singing", "no choir", "no spoken words" }) |condition| {
+        if (!containsIgnoreCase(style, condition)) {
+            try result.appendSlice(a, ", ");
+            try result.appendSlice(a, condition);
+        }
+    }
+    try result.append(a, '.');
+    return result.toOwnedSlice(a);
+}
+
+test "instrumental render style preserves genre and adds official guards" {
+    const a = std.testing.allocator;
+    const style = try renderStyle(a, "Lo-fi, Rhodes, mellow.");
+    defer a.free(style);
+    try std.testing.expectEqualStrings("Instrumental, Lo-fi, Rhodes, mellow, no vocals, no singing, no choir, no spoken words.", style);
+}
+
+test "instrumental embedded bridge moves the official example" {
+    const a = std.testing.allocator;
+    var threaded = std.Io.Threaded.init(a, .{});
+    defer threaded.deinit();
+    const result = try convert(a, threaded.io(), @embedFile("yue2_instrumental/example-original.abc"));
+    defer a.free(result.abc);
+    defer a.free(result.transfer);
+    defer a.free(result.lyrics);
+    try std.testing.expect(std.mem.indexOf(u8, result.transfer, "\"vocal_notes_after\":0") != null);
+    try std.testing.expect(std.mem.indexOf(u8, result.transfer, "\"vocal_pitch_onset_duration_preserved\":true") != null);
+}
+
+test "instrumental bridge rejects malformed and unbounded scores" {
+    const a = std.testing.allocator;
+    var threaded = std.Io.Threaded.init(a, .{});
+    defer threaded.deinit();
+    const io = threaded.io();
+    try std.testing.expectError(error.InstrumentalScoreInvalid, convert(a, io, "X:1\nK:C\nCDEF|"));
+    try std.testing.expectError(error.InstrumentalScoreTooLarge, convert(a, io, ""));
+}
