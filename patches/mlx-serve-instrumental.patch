diff --git a/tests/test_yue2_instrumental.py b/tests/test_yue2_instrumental.py
new file mode 100644
index 0000000..6ede64f
--- /dev/null
+++ b/tests/test_yue2_instrumental.py
@@ -0,0 +1,67 @@
+"""CPU-only integration of the exact embedded official score transformer."""
+import json, pathlib, subprocess, sys, unittest
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+HELPER = ROOT / 'src/yue2_instrumental/bridge.py'
+
+class InstrumentalTests(unittest.TestCase):
+    def invoke(self, score):
+        return subprocess.run([sys.executable, '-I', str(HELPER), score], capture_output=True, text=True)
+
+    def test_moves_vocal_preserves_harmony_and_ins_fill(self):
+        score = '''X:1
+T:
+M:4/4
+L:1/8
+Q:1/4=80
+V: Vocal clef=treble name="Vocal Melody" snm="Vocal"
+V: Ins clef=treble name="Ins Melody" snm="Inst."
+K:C
+% verse
+V: Vocal
+"C"C4 z4|
+V: Ins
+G8|
+'''
+        result = self.invoke(score)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        sys.path.insert(0, str(HELPER.parent))
+        from abc_tools import parse_abc
+        source, target = parse_abc(score), parse_abc(json.loads(result.stdout)['abc'])
+        self.assertFalse(target.voices['Vocal'].notes)
+        self.assertEqual(target.voices['Vocal'].chords, source.voices['Vocal'].chords)
+        self.assertEqual(target.voices['Ins'].notes, [[0, 60, 2], [2, 67, 2]])
+        self.assertEqual(target.bpm, source.bpm)
+
+    def test_invalid_score_fails_closed(self):
+        result = self.invoke('X:1\nK:C\nCDEF|')
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, '')
+
+    def test_embedded_protocol_matches_official_event_transform(self):
+        sys.path.insert(0, str(HELPER.parent))
+        from instrumentalize import convert_score
+        score = (HELPER.parent / 'example-original.abc').read_text()
+        expected, report = convert_score(score)
+        sources = {name: (HELPER.parent / (name + '.py')).read_text()
+                   for name in ('abc_tools', 'common', 'compile_score', 'instrumentalize')}
+        for python in (sys.executable, '/usr/bin/python3'):
+            result = subprocess.run([python, '-I', '-c', HELPER.read_text(), json.dumps(sources), score],
+                                    capture_output=True, text=True, timeout=10)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            data = json.loads(result.stdout)
+            self.assertEqual(data['abc'], expected)
+            self.assertEqual(data['transfer'], report)
+            self.assertEqual(report['vocal_notes_after'], 0)
+            self.assertTrue(report['vocal_pitch_onset_duration_preserved'])
+
+    def test_repeated_transfers_are_stable(self):
+        score = (HELPER.parent / 'example-original.abc').read_text()
+        first = json.loads(self.invoke(score).stdout)['abc']
+        for _ in range(3):
+            again = self.invoke(first)
+            self.assertEqual(again.returncode, 0, again.stderr)
+            data = json.loads(again.stdout)
+            self.assertEqual(data['abc'], first)
+            self.assertEqual(data['transfer']['vocal_notes_after'], 0)
+
+if __name__ == '__main__': unittest.main()
