+++ b/src/yue2_lora.zig
@@ -0,0 +1,118 @@
+//! YuE2 instrumental AR adapter. Base quantized weights remain unchanged.
+const std = @import("std");
+const mlx = @import("mlx.zig");
+const scope = @import("mlx_scope.zig");
+const A = mlx.mlx_array;
+
+/// Non-owning handles; the engine keeps adapter tensors in float32 for the
+/// reference delta arithmetic. Quantized base matmuls are never re-quantized.
+pub const Linear = struct {
+    base: scope.Linear,
+    a: ?A = null,
+    b: ?A = null,
+    enabled: ?*const bool = null,
+
+    pub fn attach(self: *Linear, down: A, up: A, enabled: *const bool) !void {
+        const w = mlx.getShape(self.base.w);
+        const sa = mlx.getShape(down);
+        const sb = mlx.getShape(up);
+        if (w.len != 2 or sa.len != 2 or sb.len != 2) return error.InstrumentalLoraShapeMismatch;
+        const input = if (self.base.scales != null) w[1] * @as(c_int, @intCast(32 / self.base.bits)) else w[1];
+        if (sa[0] <= 0 or sa[1] != input or sb[0] != w[0] or sb[1] != sa[0]) return error.InstrumentalLoraShapeMismatch;
+        self.a = down;
+        self.b = up;
+        self.enabled = enabled;
+    }
+
+    pub fn forward(self: *const Linear, sc: *scope.Scope, x: A) !A {
+        const y = try self.base.forward(sc, x);
+        if (self.enabled == null or !self.enabled.?.*) return y;
+        const down = self.a orelse return error.InstrumentalLoraIncomplete;
+        const up = self.b orelse return error.InstrumentalLoraIncomplete;
+        const rank = try sc.matmul(try sc.astype(x, .float32), try sc.transpose(down, &.{ 1, 0 }));
+        const delta = try sc.matmul(rank, try sc.transpose(up, &.{ 1, 0 }));
+        return sc.add(y, try sc.astype(delta, mlx.mlx_array_dtype(y)));
+    }
+};
+
+test "yue2 lora toggles additive projection without modifying base" {
+    const a = std.testing.allocator;
+    var sc = scope.Scope.init(a, mlx.mlx_default_gpu_stream_new());
+    defer sc.deinit();
+    const x = try sc.fromF32(&.{ 1, 2 }, &.{ 1, 2 });
+    const w = try sc.fromF32(&.{ 1, 0, 0, 1 }, &.{ 2, 2 });
+    const down = try sc.fromF32(&.{ 2, 0 }, &.{ 1, 2 });
+    const up = try sc.fromF32(&.{ 3, 4 }, &.{ 2, 1 });
+    var enabled = false;
+    var linear = Linear{ .base = .{ .w = w } };
+    try linear.attach(down, up, &enabled);
+    const off = try linear.forward(&sc, x);
+    enabled = true;
+    const on = try linear.forward(&sc, x);
+    enabled = false;
+    const restored = try linear.forward(&sc, x);
+    for ([_]struct { arr: A, want: [2]f32 }{
+        .{ .arr = off, .want = .{ 1, 2 } },
+        .{ .arr = on, .want = .{ 7, 10 } },
+        .{ .arr = restored, .want = .{ 1, 2 } },
+    }) |item| {
+        try mlx.check(mlx.mlx_array_eval(item.arr));
+        const data = mlx.mlx_array_data_float32(item.arr).?;
+        for (item.want, 0..) |value, i| try std.testing.expectApproxEqAbs(value, data[i], 1e-6);
+    }
+}
+
+test "yue2 lora rejects incompatible shapes" {
+    var sc = scope.Scope.init(std.testing.allocator, mlx.mlx_default_gpu_stream_new());
+    defer sc.deinit();
+    const w = try sc.fromF32(&.{ 1, 0, 0, 1 }, &.{ 2, 2 });
+    const wrong = try sc.fromF32(&.{ 1, 2, 3 }, &.{ 1, 3 });
+    const up = try sc.fromF32(&.{ 1, 2 }, &.{ 2, 1 });
+    var enabled = true;
+    var linear = Linear{ .base = .{ .w = w } };
+    try std.testing.expectError(error.InstrumentalLoraShapeMismatch, linear.attach(wrong, up, &enabled));
+}
+
+test "yue2 lora adds delta to an 8-bit base without requantizing" {
+    const a = std.testing.allocator;
+    const stream = mlx.mlx_default_gpu_stream_new();
+    var sc = scope.Scope.init(a, stream);
+    defer sc.deinit();
+    var weights: [128]f32 = undefined;
+    for (&weights, 0..) |*v, i| v.* = @as(f32, @floatFromInt(i % 17)) / 17;
+    const w = try sc.fromF32(&weights, &.{ 2, 64 });
+    const x = try sc.fromF32(&(@as([64]f32, @splat(1))), &.{ 1, 64 });
+    var down_data: [64]f32 = @splat(0);
+    down_data[0] = 2;
+    const down = try sc.fromF32(&down_data, &.{ 1, 64 });
+    const up = try sc.fromF32(&.{ 3, 4 }, &.{ 2, 1 });
+    var triple = mlx.mlx_vector_array_new();
+    defer _ = mlx.mlx_vector_array_free(triple);
+    try mlx.check(mlx.mlx_quantize(&triple, w, mlx.mlx_optional_int.some(64), mlx.mlx_optional_int.some(8), "affine", .{}, stream));
+    var qw = mlx.mlx_array_new();
+    var qs = mlx.mlx_array_new();
+    var qb = mlx.mlx_array_new();
+    defer _ = mlx.mlx_array_free(qw);
+    defer _ = mlx.mlx_array_free(qs);
+    defer _ = mlx.mlx_array_free(qb);
+    try mlx.check(mlx.mlx_vector_array_get(&qw, triple, 0));
+    try mlx.check(mlx.mlx_vector_array_get(&qs, triple, 1));
+    try mlx.check(mlx.mlx_vector_array_get(&qb, triple, 2));
+    var enabled = false;
+    var linear = Linear{ .base = .{ .w = qw, .scales = qs, .biases = qb, .bits = 8, .group_size = 64 } };
+    try linear.attach(down, up, &enabled);
+    const baseline = try linear.forward(&sc, x);
+    enabled = true;
+    const on = try linear.forward(&sc, x);
+    const diff = try sc.sub(on, baseline);
+    try mlx.check(mlx.mlx_array_eval(diff));
+    const data = mlx.mlx_array_data_float32(diff).?;
+    try std.testing.expectApproxEqAbs(@as(f32, 6), data[0], 1e-5);
+    try std.testing.expectApproxEqAbs(@as(f32, 8), data[1], 1e-5);
+    enabled = false;
+    const restored_diff = try sc.sub(try linear.forward(&sc, x), baseline);
+    try mlx.check(mlx.mlx_array_eval(restored_diff));
+    const restored = mlx.mlx_array_data_float32(restored_diff).?;
+    try std.testing.expectEqual(@as(f32, 0), restored[0]);
+    try std.testing.expectEqual(@as(f32, 0), restored[1]);
+}
